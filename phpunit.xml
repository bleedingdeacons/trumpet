<?xml version="1.0" encoding="UTF-8"?>
<!--
    PHPUnit 10.5 schema. Coverage include/exclude therefore lives in <source>,
    not the 9.x <coverage> element, and the convertErrorsToExceptions family is
    gone — 10.x always converts. beStrictAboutTestsThatDoNotTestAnything goes
    with them: it is the default in 10.x.

    Trumpet sat on PHPUnit 9.6 after the rest of the suite moved to 10.5,
    because it had no shared test package to move with. Adopting
    bleedingdeacons/wp-mocks is what unblocked it.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         failOnWarning="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Trumpet">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <!--
                src/Trumpet/Admin is DELIBERATELY NOT EXCLUDED. It used to be,
                on the grounds that admin screens are render/callback glue
                exercised through WordPress at runtime — but the list-table
                admin is not glue: it computes the status a row shows and the
                meta value that status is sorted by, and the settings screen
                decides whether uninstalling takes the announcements with it.
                Amber covers its whole src/Admin on the same tooling, and
                tests/Unit/Admin covers this one; see the class docblocks there
                for the three branches left uncovered and why. Do not re-add it.

                Removing the exclusion adds 325 previously invisible lines to
                the denominator, so read the headline percentage with that in
                mind: it went 751/813 (92.37%) to 1066/1138 (93.67%). It rose
                only because those lines are better covered than the average;
                a port like this one is expected to lower it, and doing so
                would not have been a regression.
            -->
            <!--
                Interface files carry no executable behaviour beyond the
                `if (!defined('ABSPATH')) exit;` guard, so there is nothing to
                unit-test in them.
            -->
            <file>src/Trumpet/Common/CacheInterface.php</file>
            <file>src/Trumpet/Announcement/AnnouncementRepositoryInterface.php</file>
        </exclude>
    </source>
</phpunit>
