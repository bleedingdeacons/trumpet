<?xml version="1.0" encoding="UTF-8"?>
<!--
    PHPUnit 9.6 schema — trumpet requires phpunit ^9.6. The 10.x layout
    (<source>, cacheDirectory) does not validate here and its coverage
    configuration is silently ignored, so keep this in step with composer.json
    if PHPUnit is ever upgraded.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutTestsThatDoNotTestAnything="true"
         failOnRisky="true"
         failOnWarning="true"
         cacheResultFile=".phpunit.cache/test-results"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="true"
         convertWarningsToExceptions="true">
    <testsuites>
        <testsuite name="Trumpet">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <coverage>
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <!--
                Admin screens are WordPress render/callback glue (metaboxes,
                settings fields, list-table columns) exercised through
                WordPress at runtime rather than in unit tests, so they are
                excluded from the coverage denominator — the same call Reach
                and Integrity make for their own src/Admin.
            -->
            <directory suffix=".php">src/Trumpet/Admin</directory>
            <!--
                Interface files carry no executable behaviour beyond the
                `if (!defined('ABSPATH')) exit;` guard, so there is nothing to
                unit-test in them.
            -->
            <file>src/Trumpet/Common/CacheInterface.php</file>
            <file>src/Trumpet/Announcement/AnnouncementRepositoryInterface.php</file>
        </exclude>
    </coverage>
</phpunit>
