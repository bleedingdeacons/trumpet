<?xml version="1.0" encoding="UTF-8"?>
<!--
    PHPUnit 10.5 schema. Coverage include/exclude therefore lives in <source>,
    not the 9.x <coverage> element, and the convertErrorsToExceptions family is
    gone — 10.x always converts. beStrictAboutTestsThatDoNotTestAnything goes
    with them: it is the default in 10.x.

    Trumpet sat on PHPUnit 9.6 after the rest of the suite moved to 10.5,
    because it had no shared test package to move with. Adopting
    bleedingdeacons/wp-mocks is what unblocked it.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         failOnWarning="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Trumpet">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <!--
                Admin screens are WordPress render/callback glue (metaboxes,
                settings fields, list-table columns) exercised through
                WordPress at runtime rather than in unit tests, so they are
                excluded from the coverage denominator — the same call Reach
                and Integrity make for their own src/Admin.
            -->
            <directory suffix=".php">src/Trumpet/Admin</directory>
            <!--
                Interface files carry no executable behaviour beyond the
                `if (!defined('ABSPATH')) exit;` guard, so there is nothing to
                unit-test in them.
            -->
            <file>src/Trumpet/Common/CacheInterface.php</file>
            <file>src/Trumpet/Announcement/AnnouncementRepositoryInterface.php</file>
        </exclude>
    </source>
</phpunit>
